  <property name="styleSheet">
   <string notr="true">/* =========================================================
   MAIN LOGIN WINDOW
   ========================================================= */

QMainWindow {
    background-color: #000000;
}


/* =========================================================
   HEADER
   ========================================================= */

#headerPanel {
    background-color: #1E293B;
}

#logoLabel {
    color: white;
    font-family: &quot;Segoe UI&quot;;
    font-size: 32pt;
    font-weight: bold;
}

#titleLabel {
    color: white;
    font-family: &quot;Segoe UI&quot;;
    font-size: 20pt;
    font-weight: bold;
}

#subtitleLabel {
    color: #CBD5E1;
    font-family: &quot;Segoe UI&quot;;
    font-size: 10pt;
}


/* =========================================================
   LOGIN CARD
   ========================================================= */

#loginPanel {
    background-color: white;
    border: 1px solid #E2E8F0;
    border-radius: 18px;
}


/* =========================================================
   WELCOME
   ========================================================= */

#welcomeLabel {
    color: #1E293B;
    font-family: &quot;Segoe UI&quot;;
    font-size: 24pt;
    font-weight: bold;
}

#welcomeSubtitleLabel {
    color: #64748B;
    font-family: &quot;Segoe UI&quot;;
    font-size: 10pt;
}


/* =========================================================
   LABELS
   ========================================================= */

#usernameLabel,
#passwordLabel {
    color: #334155;
    font-family: &quot;Segoe UI&quot;;
    font-size: 11pt;
    font-weight: bold;
}


/* =========================================================
   TEXT BOXES
   ========================================================= */

#usernameTextBox,
#passwordTextBox {
    background-color: #F8FAFC;
    color: #1E293B;

    border: 2px solid #CBD5E1;
    border-radius: 8px;

    padding: 8px;

    font-family: &quot;Segoe UI&quot;;
    font-size: 11pt;
}

#usernameTextBox:focus,
#passwordTextBox:focus {
    border: 2px solid #2563EB;
    background-color: white;
}


/* =========================================================
   SHOW PASSWORD
   ========================================================= */

#showPasswordCheckBox {
    color: #475569;
    font-family: &quot;Segoe UI&quot;;
    font-size: 10pt;
}


/* =========================================================
   LOGIN BUTTON
   ========================================================= */

#loginButton {
    background-color: #2563EB;
    color: white;

    border: none;
    border-radius: 8px;

    font-family: &quot;Segoe UI&quot;;
    font-size: 11pt;
    font-weight: bold;

    padding: 10px;
}

#loginButton:hover {
    background-color: #1D4ED8;
}

#loginButton:pressed {
    background-color: #1E40AF;
}


/* =========================================================
   CLEAR BUTTON
   ========================================================= */

#clearButton {
    background-color: #E2E8F0;
    color: #334155;

    border: none;
    border-radius: 8px;

    font-family: &quot;Segoe UI&quot;;
    font-size: 11pt;
    font-weight: bold;

    padding: 10px;
}

#clearButton:hover {
    background-color: #CBD5E1;
}

#clearButton:pressed {
    background-color: #94A3B8;
}


/* =========================================================
   BACK BUTTON
   ========================================================= */

#backButton {
    background-color: transparent;
    color: #2563EB;

    border: none;

    font-family: &quot;Segoe UI&quot;;
    font-size: 10pt;
    font-weight: bold;
}

#backButton:hover {
    color: #1D4ED8;
}


/* =========================================================
   STATUS
   ========================================================= */

#statusLabel {
    color: #DC2626;

    font-family: &quot;Segoe UI&quot;;
    font-size: 9.5pt;

    padding: 5px;
}


/* =========================================================
   FOOTER
   ========================================================= */

#footerLabel {
    color: #94A3B8;

    font-family: &quot;Segoe UI&quot;;
    font-size: 9pt;
}</string>
