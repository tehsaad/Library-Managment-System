  <property name="styleSheet">
   <string notr="true">/* =========================================================
   LMS DASHBOARD
   ========================================================= */


/* =========================================================
   MAIN WINDOW
   ========================================================= */

QMainWindow {
    background-color: #F5F7FA;
}


/* =========================================================
   CENTRAL WIDGET
   ========================================================= */

#centralWidget {
    background-color: #F5F7FA;
}


/* =========================================================
   HEADER
   ========================================================= */

#headerPanel {
    background-color: #1E293B;
    border: none;
}


/* =========================================================
   LMS LOGO
   ========================================================= */

#logoLabel {
    color: #FFFFFF;

    font-family: &quot;Segoe UI&quot;;
    font-size: 28pt;
    font-weight: bold;

    background-color: transparent;
}


/* =========================================================
   HEADER TITLE
   ========================================================= */

#titleLabel {
    color: #FFFFFF;

    font-family: &quot;Segoe UI&quot;;
    font-size: 18pt;
    font-weight: bold;

    background-color: transparent;
}


/* =========================================================
   HEADER SUBTITLE
   ========================================================= */

#subtitleLabel {
    color: #CBD5E1;

    font-family: &quot;Segoe UI&quot;;
    font-size: 9.5pt;

    background-color: transparent;
}


/* =========================================================
   USER INFORMATION PANEL
   ========================================================= */

#userInfoPanel {
    background-color: transparent;
    border: none;
}


/* =========================================================
   USERNAME
   ========================================================= */

#usernameLabel {
    color: #FFFFFF;

    font-family: &quot;Segoe UI&quot;;
    font-size: 11pt;
    font-weight: bold;

    background-color: transparent;
}


/* =========================================================
   AUTHORITY
   ========================================================= */

#authorityLabel {
    color: #60A5FA;

    font-family: &quot;Segoe UI&quot;;
    font-size: 9pt;
    font-weight: bold;

    background-color: transparent;
}


/* =========================================================
   CONTENT AREA
   ========================================================= */

#contentPanel {
    background-color: #F5F7FA;
    border: none;
}


/* =========================================================
   LEFT SIDEBAR
   ========================================================= */

#sidePanel {
    background-color: #0F172A;

    border: none;
}


/* =========================================================
   ALL SIDEBAR BUTTONS - BASE
   ========================================================= */

#sidePanel QPushButton {
    background-color: transparent;

    color: #CBD5E1;

    border: none;
    border-radius: 7px;

    font-family: &quot;Segoe UI&quot;;
    font-size: 10pt;
    font-weight: bold;

    text-align: left;

    padding-left: 20px;
    padding-right: 10px;

    min-height: 42px;
}


/* =========================================================
   SIDEBAR BUTTON - HOVER
   ========================================================= */

#sidePanel QPushButton:hover {
    background-color: #1E293B;
    color: #FFFFFF;
}


/* =========================================================
   SIDEBAR BUTTON - PRESSED
   ========================================================= */

#sidePanel QPushButton:pressed {
    background-color: #334155;
    color: #FFFFFF;
}


/* =========================================================
   DASHBOARD BUTTON
   ========================================================= */

#dashboardButton {
    background-color: #2563EB !important;
    color: #FFFFFF !important;

    border-radius: 7px;

    font-weight: bold;
}


#dashboardButton:hover {
    background-color: #1D4ED8 !important;
}


#dashboardButton:pressed {
    background-color: #1E40AF !important;
}


/* =========================================================
   STUDENT BUTTONS
   ========================================================= */

#myBooksButton:hover,
#borrowedBooksButton:hover,
#historyButton:hover {
    background-color: #1E3A8A;
    color: #FFFFFF;
}


/* =========================================================
   FACULTY BUTTONS
   ========================================================= */

#manageBooksButton:hover,
#issueBookButton:hover,
#returnBookButton:hover,
#membersButton:hover {
    background-color: #065F46;
    color: #FFFFFF;
}


/* =========================================================
   ADMIN BUTTONS
   ========================================================= */

#usersButton:hover,
#booksButton:hover,
#facultyButton:hover,
#volunteersButton:hover,
#reportsButton:hover,
#settingsButton:hover {
    background-color: #5B21B6;
    color: #FFFFFF;
}


/* =========================================================
   PROFILE BUTTON
   ========================================================= */

#profileButton {
    color: #CBD5E1;
}


#profileButton:hover {
    background-color: #475569;
    color: #FFFFFF;
}


/* =========================================================
   LOGOUT BUTTON
   ========================================================= */

#logoutButton {
    color: #FCA5A5;
}


#logoutButton:hover {
    background-color: #7F1D1D;
    color: #FFFFFF;
}


#logoutButton:pressed {
    background-color: #991B1B;
    color: #FFFFFF;
}


/* =========================================================
   TABLE PANEL
   ========================================================= */

#tablePanel {
    background-color: #F5F7FA;

    border: none;
}


/* =========================================================
   TABLE TITLE
   ========================================================= */

#tableTitleLabel {
    color: #1E293B;

    font-family: &quot;Segoe UI&quot;;
    font-size: 17pt;
    font-weight: bold;

    background-color: transparent;
}


/* =========================================================
   DATA TABLE
   ========================================================= */

#dataTable {
    background-color: #FFFFFF;

    color: #1E293B;

    border: 1px solid #E2E8F0;

    border-radius: 8px;

    gridline-color: #E2E8F0;

    font-family: &quot;Segoe UI&quot;;
    font-size: 10pt;

    selection-background-color: #DBEAFE;
    selection-color: #1E3A8A;
}


/* =========================================================
   TABLE HEADER
   ========================================================= */

#dataTable QHeaderView::section {
    background-color: #1E293B;

    color: #FFFFFF;

    border: none;

    padding: 10px;

    font-family: &quot;Segoe UI&quot;;
    font-size: 10pt;
    font-weight: bold;
}


/* =========================================================
   TABLE HEADER - HOVER
   ========================================================= */

#dataTable QHeaderView::section:hover {
    background-color: #334155;
}


/* =========================================================
   TABLE CORNER
   ========================================================= */

#dataTable QTableCornerButton::section {
    background-color: #1E293B;
    border: none;
}


/* =========================================================
   TABLE SCROLLBAR
   ========================================================= */

#dataTable QScrollBar:vertical {
    background-color: #F1F5F9;

    width: 10px;

    margin: 0px;
}


#dataTable QScrollBar::handle:vertical {
    background-color: #CBD5E1;

    border-radius: 5px;

    min-height: 30px;
}


#dataTable QScrollBar::handle:vertical:hover {
    background-color: #94A3B8;
}


#dataTable QScrollBar::add-line:vertical,
#dataTable QScrollBar::sub-line:vertical {
    height: 0px;
}


#dataTable QScrollBar:horizontal {
    background-color: #F1F5F9;

    height: 10px;
}


#dataTable QScrollBar::handle:horizontal {
    background-color: #CBD5E1;

    border-radius: 5px;

    min-width: 30px;
}


#dataTable QScrollBar::handle:horizontal:hover {
    background-color: #94A3B8;
}


#dataTable QScrollBar::add-line:horizontal,
#dataTable QScrollBar::sub-line:horizontal {
    width: 0px;
}


/* =========================================================
   FOOTER
   ========================================================= */

#footerLabel {
    color: #64748B;

    font-family: &quot;Segoe UI&quot;;
    font-size: 9pt;

    background-color: transparent;
}</string>
