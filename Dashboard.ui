  <property name="styleSheet">
   <string notr="true">/* =========================================================
   LMS DASHBOARD
   ========================================================= */


/* =========================================================
   MAIN WINDOW
   ========================================================= */

QMainWindow {
    background-color: #F5F7FA;
}


/* =========================================================
   CENTRAL WIDGET
   ========================================================= */

#centralwidget {
    background-color: #F5F7FA;
}


/* =========================================================
   HEADER
   ========================================================= */

#headerPanel {
    background-color: #1E293B;
    border: none;
}


/* =========================================================
   LMS LOGO
   Actual objectName: label
   ========================================================= */

#label {
    color: #FFFFFF;

    font-family: &quot;Segoe UI&quot;;
    font-size: 28pt;
    font-weight: bold;

    background-color: transparent;
}


/* =========================================================
   HEADER TITLE
   ========================================================= */

#titleLabel {
    color: #FFFFFF;

    font-family: &quot;Segoe UI&quot;;
    font-size: 18pt;
    font-weight: bold;

    background-color: transparent;
}


/* =========================================================
   HEADER SUBTITLE
   ========================================================= */

#subtitleLabel {
    color: #CBD5E1;

    font-family: &quot;Segoe UI&quot;;
    font-size: 9.5pt;

    background-color: transparent;
}


/* =========================================================
   USER INFORMATION AREA
   Actual objectName: widget
   ========================================================= */

#widget {
    background-color: transparent;
    border: none;
}


/* =========================================================
   USERNAME
   ========================================================= */

#usernameLabel {
    color: #FFFFFF;

    font-family: &quot;Segoe UI&quot;;
    font-size: 11pt;
    font-weight: bold;

    background-color: transparent;
}


/* =========================================================
   AUTHORITY
   ========================================================= */

#authorityLabel {
    color: #60A5FA;

    font-family: &quot;Segoe UI&quot;;
    font-size: 9pt;
    font-weight: bold;

    background-color: transparent;
}


/* =========================================================
   CONTENT AREA
   Actual objectName: contentLayout
   ========================================================= */

#contentLayout {
    background-color: #F5F7FA;
    border: none;
}


/* =========================================================
   LEFT SIDEBAR
   ========================================================= */

#sidePanel {
    background-color: #0F172A;
    border: none;
}


/* =========================================================
   ALL SIDEBAR BUTTONS
   ========================================================= */

#sidePanel QPushButton {
    background-color: transparent;

    color: #CBD5E1;

    border: 1px solid #334155;
    border-radius: 7px;

    font-family: &quot;Segoe UI&quot;;
    font-size: 10pt;
    font-weight: bold;

    text-align: left;

    padding-left: 20px;
    padding-right: 10px;

    min-height: 42px;
}


/* =========================================================
   BUTTON HOVER
   ========================================================= */

#sidePanel QPushButton:hover {
    background-color: #1E293B;

    color: #FFFFFF;

    border: 1px solid #475569;
}


/* =========================================================
   BUTTON PRESSED
   ========================================================= */

#sidePanel QPushButton:pressed {
    background-color: #334155;

    color: #FFFFFF;

    border: 1px solid #64748B;
}


/* =========================================================
   DASHBOARD BUTTON
   ========================================================= */

#dashboardButton {
    background-color: #2563EB;

    color: #FFFFFF;

    border: 1px solid #60A5FA;
    border-radius: 7px;

    font-weight: bold;
}


/* DASHBOARD HOVER */

#dashboardButton:hover {
    background-color: #1D4ED8;

    color: #FFFFFF;

    border: 1px solid #93C5FD;
}


/* DASHBOARD PRESSED */

#dashboardButton:pressed {
    background-color: #1E40AF;

    color: #FFFFFF;

    border: 1px solid #BFDBFE;
}


/* =========================================================
   STUDENT BUTTONS
   ========================================================= */

#myBooksButton {
    border: 1px solid #334155;
}

#borrowedBooksButton {
    border: 1px solid #334155;
}

#historyButton {
    border: 1px solid #334155;
}


/* STUDENT HOVER */

#myBooksButton:hover,
#borrowedBooksButton:hover,
#historyButton:hover {
    background-color: #1E3A8A;

    color: #FFFFFF;

    border: 1px solid #3B82F6;
}


/* =========================================================
   FACULTY BUTTONS
   ========================================================= */

#manageBooksButton,
#issueBookButton,
#returnBookButton,
#membersButton {
    border: 1px solid #334155;
}


/* FACULTY HOVER */

#manageBooksButton:hover,
#issueBookButton:hover,
#returnBookButton:hover,
#membersButton:hover {
    background-color: #065F46;

    color: #FFFFFF;

    border: 1px solid #10B981;
}


/* =========================================================
   ADMIN BUTTONS
   ========================================================= */

#usersButton,
#booksButton,
#facultyButton,
#volunteersButton,
#reportsButton,
#settingsButton {
    border: 1px solid #334155;
}


/* ADMIN HOVER */

#usersButton:hover,
#booksButton:hover,
#facultyButton:hover,
#volunteersButton:hover,
#reportsButton:hover,
#settingsButton:hover {
    background-color: #5B21B6;

    color: #FFFFFF;

    border: 1px solid #8B5CF6;
}


/* =========================================================
   PROFILE BUTTON
   ========================================================= */

#profileButton {
    color: #CBD5E1;

    border: 1px solid #334155;
}


#profileButton:hover {
    background-color: #475569;

    color: #FFFFFF;

    border: 1px solid #64748B;
}


#profileButton:pressed {
    background-color: #334155;

    color: #FFFFFF;

    border: 1px solid #94A3B8;
}


/* =========================================================
   LOGOUT BUTTON
   ========================================================= */

#logoutButton {
    color: #FCA5A5;

    border: 1px solid #7F1D1D;
}


#logoutButton:hover {
    background-color: #7F1D1D;

    color: #FFFFFF;

    border: 1px solid #EF4444;
}


#logoutButton:pressed {
    background-color: #991B1B;

    color: #FFFFFF;

    border: 1px solid #F87171;
}


/* =========================================================
   TABLE PANEL
   ========================================================= */

#tablePanel {
    background-color: #F5F7FA;
    border: none;
}


/* =========================================================
   TABLE
   Actual objectName: tableWidget
   ========================================================= */

#tableWidget {
    background-color: #FFFFFF;

    color: #1E293B;

    border: 1px solid #CBD5E1;
    border-radius: 8px;

    gridline-color: #E2E8F0;

    font-family: &quot;Segoe UI&quot;;
    font-size: 10pt;

    selection-background-color: #DBEAFE;
    selection-color: #1E3A8A;
}


/* =========================================================
   TABLE HEADER
   ========================================================= */

#tableWidget QHeaderView::section {
    background-color: #1E293B;

    color: #FFFFFF;

    border: none;

    padding: 10px;

    font-family: &quot;Segoe UI&quot;;
    font-size: 10pt;
    font-weight: bold;
}


/* =========================================================
   TABLE HEADER HOVER
   ========================================================= */

#tableWidget QHeaderView::section:hover {
    background-color: #334155;
}


/* =========================================================
   TABLE CORNER
   ========================================================= */

#tableWidget QTableCornerButton::section {
    background-color: #1E293B;

    border: none;
}


/* =========================================================
   TABLE VERTICAL SCROLLBAR
   ========================================================= */

#tableWidget QScrollBar:vertical {
    background-color: #F1F5F9;

    width: 10px;

    margin: 0px;
}


#tableWidget QScrollBar::handle:vertical {
    background-color: #CBD5E1;

    border-radius: 5px;

    min-height: 30px;
}


#tableWidget QScrollBar::handle:vertical:hover {
    background-color: #94A3B8;
}


#tableWidget QScrollBar::add-line:vertical,
#tableWidget QScrollBar::sub-line:vertical {
    height: 0px;
}


/* =========================================================
   TABLE HORIZONTAL SCROLLBAR
   ========================================================= */

#tableWidget QScrollBar:horizontal {
    background-color: #F1F5F9;

    height: 10px;
}


#tableWidget QScrollBar::handle:horizontal {
    background-color: #CBD5E1;

    border-radius: 5px;

    min-width: 30px;
}


#tableWidget QScrollBar::handle:horizontal:hover {
    background-color: #94A3B8;
}


#tableWidget QScrollBar::add-line:horizontal,
#tableWidget QScrollBar::sub-line:horizontal {
    width: 0px;
}


/* =========================================================
   FOOTER
   ========================================================= */

#footerLabel {
    color: #64748B;

    font-family: &quot;Segoe UI&quot;;
    font-size: 9pt;

    background-color: transparent;
}</string>
